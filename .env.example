# NAS Homepage 环境变量配置
# 复制此文件为 .env 后修改，.env 已被 .gitignore 排除，不会提交到仓库

# Lucky 配置
LUCKY_ENABLED=true
# Lucky的局域网地址（请替换为你的NAS IP）
LUCKY_BASE_URL=http://192.168.x.x:16601
# Lucky openToken（在Lucky后台生成，注意保密）
LUCKY_OPEN_TOKEN=

# Docker 配置
DOCKER_ENABLED=true

# 自动发现扫描间隔（秒，最小30）
AUTO_DISCOVERY_INTERVAL=300

# NAS真实局域网IP（可选，自动检测失败时手动指定）
NAS_LAN_IP=

# 可信代理IP列表（JSON数组格式，如 ["172.25.0.1"]；配置后才会信任 X-Forwarded-For 头）
TRUSTED_PROXIES=[]

# 自定义内网网段（JSON数组格式）
CUSTOM_LAN_RANGES=[]
